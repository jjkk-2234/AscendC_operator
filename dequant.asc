#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <algorithm>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"
#include "tiling/platform/platform_ascendc.h"

class KernelDequant {
public:
    __aicore__ inline KernelDequant() {

    }
    // 新增参数 l2DisableX：是否关闭 xGm 的 L2 Cache（默认 false = 保持原行为）
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR s, GM_ADDR y, uint32_t M, uint32_t N, uint32_t tileLength,
                                bool l2DisableX = false) {
        this->M = M;
        this->N = N;
        this->tileLength = tileLength;
        uint32_t blockIdx = AscendC::GetBlockIdx();
        uint32_t blockNum = AscendC::GetBlockNum();
        // 计算一个核要处理多少个M行
        singleCoreM = M / blockNum;
        // 计算尾部的M行数
        uint32_t tailM = M % blockNum;
        if (blockIdx < tailM) {
            singleCoreM += 1;
            uint32_t singleCoreTotal = singleCoreM * N;
            uint32_t offset = blockIdx * singleCoreM * N;
            xGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(x) + offset, singleCoreTotal);
            yGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y) + offset, singleCoreTotal);
        } else {
            uint32_t singleCoreTotal = singleCoreM * N;
            uint32_t offset = tailM * (singleCoreM + 1) * N + (blockIdx - tailM) * singleCoreM * N;
            xGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(x) + offset, singleCoreTotal);
            yGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y) + offset, singleCoreTotal);
        }
        sGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(s), N);

        // L2 Cache 优化：只关 xGm（纯流式，只读一次），sGm / yGm 保持默认 CACHE_MODE_NORMAL。
        // 理由、依据与验证方法见 README「④ 一步步的优化过程 · Step 4」。
        if (l2DisableX) {
            xGm.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_DISABLE);
        }
    }
    
    __aicore__ inline void Process1() {
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        AscendC::LocalTensor<int32_t> xLocal = ubAllocator.Alloc<AscendC::TPosition::VECIN, int32_t>(tileLength);
        AscendC::LocalTensor<float> xcastLocal = ubAllocator.Alloc<AscendC::TPosition::VECCALC, float>(tileLength);
        AscendC::LocalTensor<float> sLocal = ubAllocator.Alloc<AscendC::TPosition::VECIN, float>(tileLength);
        AscendC::LocalTensor<float> yLocal = ubAllocator.Alloc<AscendC::TPosition::VECOUT, float>(tileLength);
        uint32_t loopCount = (N + tileLength - 1) / tileLength;
        for (uint32_t i = 0; i < singleCoreM; i++) {
            for (uint32_t j = 0; j < loopCount; j++) {
                // CopyIn阶段
                uint32_t actualTileLength = N - j * tileLength;
                actualTileLength = (actualTileLength > tileLength) ? tileLength : actualTileLength;
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
                AscendC::DataCopyExtParams xCopyParams{};
                xCopyParams.blockCount = 1;
                xCopyParams.blockLen = actualTileLength * sizeof(int32_t);
                xCopyParams.srcStride = 0;
                xCopyParams.dstStride = 0;
                AscendC::DataCopyExtParams sCopyParams{};
                sCopyParams.blockCount = 1;
                sCopyParams.blockLen = actualTileLength * sizeof(float);
                sCopyParams.srcStride = 0;
                sCopyParams.dstStride = 0;
                AscendC::DataCopyPadExtParams<int32_t> xPadParams{};
                xPadParams.isPad = false;
                xPadParams.leftPadding = 0;
                xPadParams.rightPadding = 0;
                xPadParams.paddingValue = 0;
                AscendC::DataCopyPadExtParams<float> sPadParams{};
                sPadParams.isPad = false;
                sPadParams.leftPadding = 0;
                sPadParams.rightPadding = 0;
                sPadParams.paddingValue = 0.0f;
                uint32_t sOffset = j * tileLength;
                uint32_t xOffset = i * N + sOffset;
                AscendC::DataCopyPad(xLocal, xGm[xOffset], xCopyParams, xPadParams);
                AscendC::DataCopyPad(sLocal, sGm[sOffset], sCopyParams, sPadParams);
                AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID1);
                // Compute阶段
                AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID1);
                AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
                AscendC::Cast(xcastLocal, xLocal, AscendC::RoundMode::CAST_RINT, actualTileLength);
                AscendC::Mul(yLocal, xcastLocal, sLocal, actualTileLength);
                AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
                AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                AscendC::DataCopyExtParams yCopyParams{};
                yCopyParams.blockCount = 1;
                yCopyParams.blockLen = actualTileLength * sizeof(float);
                yCopyParams.srcStride = 0;
                yCopyParams.dstStride = 0;
                // Copyout阶段
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                AscendC::DataCopyPad(yGm[xOffset], yLocal, yCopyParams);
                AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
            }
        }
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
    }

    __aicore__ inline void Process2() {
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        AscendC::LocalTensor<int32_t> xLocal = ubAllocator.Alloc<AscendC::TPosition::VECIN, int32_t>(tileLength);
        AscendC::LocalTensor<float> xcastLocal = ubAllocator.Alloc<AscendC::TPosition::VECCALC, float>(tileLength);
        AscendC::LocalTensor<float> sLocal = ubAllocator.Alloc<AscendC::TPosition::VECIN, float>(tileLength);
        AscendC::LocalTensor<float> yLocal = ubAllocator.Alloc<AscendC::TPosition::VECOUT, float>(tileLength);
        //
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0); // s可写
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1); // x可写
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID2); // y可写
        //
        uint32_t loopCount = (N + tileLength - 1) / tileLength;
        // 先对s循环，再对x循环
        for (uint32_t j = 0; j < loopCount; j++) {
            // 计算tile参数
            uint32_t actualTileLength = N - j * tileLength;
            actualTileLength = (actualTileLength > tileLength) ? tileLength : actualTileLength;
            // s拷贝参数
            AscendC::DataCopyExtParams sCopyParams{};
            sCopyParams.blockCount = 1;
            sCopyParams.blockLen = actualTileLength * sizeof(float);
            sCopyParams.srcStride = 0;
            sCopyParams.dstStride = 0;
            // s填充参数
            AscendC::DataCopyPadExtParams<float> sPadParams{};
            sPadParams.isPad = false;
            sPadParams.leftPadding = 0;
            sPadParams.rightPadding = 0;
            sPadParams.paddingValue = 0.0f;
            // 计算sOffset
            uint32_t sOffset = j * tileLength;
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
            AscendC::DataCopyPad(sLocal, sGm[sOffset], sCopyParams, sPadParams);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
            // x循环
            for (uint32_t i = 0; i < singleCoreM; i++) {
                // CopyIn阶段    
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
                // x拷贝参数
                AscendC::DataCopyExtParams xCopyParams{};
                xCopyParams.blockCount = 1;
                xCopyParams.blockLen = actualTileLength * sizeof(int32_t);
                xCopyParams.srcStride = 0;
                xCopyParams.dstStride = 0;
                // x填充参数
                AscendC::DataCopyPadExtParams<int32_t> xPadParams{};
                xPadParams.isPad = false;
                xPadParams.leftPadding = 0;
                xPadParams.rightPadding = 0;
                xPadParams.paddingValue = 0;
                //
                uint32_t xOffset = i * N + sOffset;
                AscendC::DataCopyPad(xLocal, xGm[xOffset], xCopyParams, xPadParams);
                AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID1);
                // Compute阶段
                if (i == 0) {
                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                }
                AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID1);
                AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID2);
                AscendC::Cast(xcastLocal, xLocal, AscendC::RoundMode::CAST_RINT, actualTileLength);
                AscendC::Mul(yLocal, xcastLocal, sLocal, actualTileLength);
                if (i == singleCoreM - 1) {
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                }
                AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
                AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID2);
                //
                AscendC::DataCopyExtParams yCopyParams{};
                yCopyParams.blockCount = 1;
                yCopyParams.blockLen = actualTileLength * sizeof(float);
                yCopyParams.srcStride = 0;
                yCopyParams.dstStride = 0;
                // Copyout阶段
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID2);
                AscendC::DataCopyPad(yGm[xOffset], yLocal, yCopyParams);
                AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID2);
            }
        }
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID2);
    }

    __aicore__ inline void ProcessGroup(uint32_t group) {
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        AscendC::LocalTensor<int32_t> xLocal = ubAllocator.Alloc<AscendC::TPosition::VECIN, int32_t>(group * tileLength);
        AscendC::LocalTensor<float> sLocal = ubAllocator.Alloc<AscendC::TPosition::VECIN, float>(tileLength);
        AscendC::LocalTensor<float> yLocal = ubAllocator.Alloc<AscendC::TPosition::VECOUT, float>(group * tileLength);
        //
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0); // s可写
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1); // x可写
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID2); // y可写
        //
        uint32_t loopCount = (N + tileLength - 1) / tileLength;
        // 先对s循环，再对x循环
        for (uint32_t j = 0; j < loopCount; j++) {
            // 计算tile参数
            uint32_t actualTileLength = N - j * tileLength;
            actualTileLength = (actualTileLength > tileLength) ? tileLength : actualTileLength;
            // pitch是actualTileLength按照32B对齐后的元素数, 因为使用了DataCopyPad, 所以一定要知道才行
            uint32_t pitch = static_cast<uint32_t>((static_cast<uint64_t>(actualTileLength) * sizeof(int32_t) + 31) / 32 * 32 / sizeof(int32_t));
            // s拷贝参数
            AscendC::DataCopyExtParams sCopyParams{};
            sCopyParams.blockCount = 1;
            sCopyParams.blockLen = actualTileLength * sizeof(float);
            sCopyParams.srcStride = 0;
            sCopyParams.dstStride = 0;
            // s填充参数
            AscendC::DataCopyPadExtParams<float> sPadParams{};
            sPadParams.isPad = false;
            sPadParams.leftPadding = 0;
            sPadParams.rightPadding = 0;
            sPadParams.paddingValue = 0.0f;
            // 计算sOffset
            uint32_t sOffset = j * tileLength;
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
            AscendC::DataCopyPad(sLocal, sGm[sOffset], sCopyParams, sPadParams);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
            // x循环
            for (uint32_t row0 = 0; row0 < singleCoreM; row0 += group) {
                uint32_t actualRow = singleCoreM - row0;
                actualRow = (actualRow > group) ? group : actualRow;
                // CopyIn阶段
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
                // x拷贝参数
                AscendC::DataCopyExtParams xCopyParams{};
                xCopyParams.blockCount = static_cast<uint16_t>(actualRow);
                xCopyParams.blockLen = actualTileLength * sizeof(int32_t);
                // 1B
                xCopyParams.srcStride = (N - actualTileLength) * sizeof(int32_t);
                // 32B
                xCopyParams.dstStride = 0;
                // x填充参数
                AscendC::DataCopyPadExtParams<int32_t> xPadParams{};
                xPadParams.isPad = false;
                xPadParams.leftPadding = 0;
                xPadParams.rightPadding = 0;
                xPadParams.paddingValue = 0;
                //
                uint32_t xOffset = row0 * N + sOffset;
                AscendC::DataCopyPad(xLocal, xGm[xOffset], xCopyParams, xPadParams);
                AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID1);
                // Compute阶段
                if (row0 == 0) {
                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                }
                AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID1);
                AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID2);
                for (uint32_t row = 0; row < actualRow; row++) {
                    // DataCopyPad的时候把尾部行元素搬运的时候补齐到了32B，所以Offset要按照补齐后的分形去算
                    uint32_t Offset = row * pitch;
                    AscendC::Cast(yLocal[Offset], xLocal[Offset], AscendC::RoundMode::CAST_RINT, actualTileLength);
                    AscendC::Mul(yLocal[Offset], yLocal[Offset], sLocal, actualTileLength);
                }
                if (row0 + actualRow == singleCoreM) {
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                }
                
                AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
                AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID2);
                //
                AscendC::DataCopyExtParams yCopyParams{};
                yCopyParams.blockCount = static_cast<uint16_t>(actualRow);
                yCopyParams.blockLen = actualTileLength * sizeof(float);
                yCopyParams.srcStride = (pitch - actualTileLength) * sizeof(float) / 32;
                yCopyParams.dstStride = (N - actualTileLength) * sizeof(float);
                // Copyout阶段
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID2);
                AscendC::DataCopyPad(yGm[xOffset], yLocal, yCopyParams);
                AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID2);
            }
        }
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID2);
    }

    __aicore__ inline void ProcessDoubleBuffer() {
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        AscendC::LocalTensor<int32_t> xLocalPing = ubAllocator.Alloc<AscendC::TPosition::VECIN, int32_t>(tileLength);
        AscendC::LocalTensor<int32_t> xLocalPong = ubAllocator.Alloc<AscendC::TPosition::VECIN, int32_t>(tileLength);
        AscendC::LocalTensor<float> sLocal = ubAllocator.Alloc<AscendC::TPosition::VECIN, float>(tileLength);
        AscendC::LocalTensor<float> yLocalPing = ubAllocator.Alloc<AscendC::TPosition::VECOUT, float>(tileLength);
        AscendC::LocalTensor<float> yLocalPong = ubAllocator.Alloc<AscendC::TPosition::VECOUT, float>(tileLength);
        //
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0); // s可写
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1); // xPing可写
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID3); // xPong可写
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID2); // yPing可写
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID4); // yPong可写
        //
        uint32_t loopCount = (N + tileLength - 1) / tileLength;
        // 先对s循环，再对x循环
        for (uint32_t j = 0; j < loopCount; j++) {
            // 计算tile参数
            uint32_t actualTileLength = N - j * tileLength;
            actualTileLength = (actualTileLength > tileLength) ? tileLength : actualTileLength;
            // s拷贝参数
            AscendC::DataCopyExtParams sCopyParams{};
            sCopyParams.blockCount = 1;
            sCopyParams.blockLen = actualTileLength * sizeof(float);
            sCopyParams.srcStride = 0;
            sCopyParams.dstStride = 0;
            // s填充参数
            AscendC::DataCopyPadExtParams<float> sPadParams{};
            sPadParams.isPad = false;
            sPadParams.leftPadding = 0;
            sPadParams.rightPadding = 0;
            sPadParams.paddingValue = 0.0f;
            // 计算sOffset
            uint32_t sOffset = j * tileLength;
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
            AscendC::DataCopyPad(sLocal, sGm[sOffset], sCopyParams, sPadParams);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
            // x循环
            for (uint32_t i = 0; i < singleCoreM; i++) {
                // 确定双缓冲的参数
                uint32_t bufferIdx = i % 2;
                AscendC::LocalTensor<int32_t> xLocalBuffer = (bufferIdx == 0) ? xLocalPing : xLocalPong;
                AscendC::LocalTensor<float> yLocalBuffer = (bufferIdx == 0) ? yLocalPing : yLocalPong;
                uint32_t xEventID = (bufferIdx == 0) ? EVENT_ID1 : EVENT_ID3;
                uint32_t yEventID = (bufferIdx == 0) ? EVENT_ID2 : EVENT_ID4;
                // CopyIn阶段 
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(xEventID);
                // x拷贝参数
                AscendC::DataCopyExtParams xCopyParams{};
                xCopyParams.blockCount = 1;
                xCopyParams.blockLen = actualTileLength * sizeof(int32_t);
                xCopyParams.srcStride = 0;
                xCopyParams.dstStride = 0;
                // x填充参数
                AscendC::DataCopyPadExtParams<int32_t> xPadParams{};
                xPadParams.isPad = false;
                xPadParams.leftPadding = 0;
                xPadParams.rightPadding = 0;
                xPadParams.paddingValue = 0;
                //
                uint32_t xOffset = i * N + sOffset;
                AscendC::DataCopyPad(xLocalBuffer, xGm[xOffset], xCopyParams, xPadParams);
                AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(xEventID);
                // Compute阶段
                if (i == 0) {
                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                }
                AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(xEventID);
                AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(yEventID);
                AscendC::Cast(yLocalBuffer, xLocalBuffer, AscendC::RoundMode::CAST_RINT, actualTileLength);
                AscendC::Mul(yLocalBuffer, yLocalBuffer, sLocal, actualTileLength);
                if (i == singleCoreM - 1) {
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                }
                AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(xEventID);
                AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(yEventID);
                //
                AscendC::DataCopyExtParams yCopyParams{};
                yCopyParams.blockCount = 1;
                yCopyParams.blockLen = actualTileLength * sizeof(float);
                yCopyParams.srcStride = 0;
                yCopyParams.dstStride = 0;
                // Copyout阶段
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(yEventID);
                AscendC::DataCopyPad(yGm[xOffset], yLocalBuffer, yCopyParams);
                AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(yEventID);
            }
        }
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID3);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID2);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID4);
    }

    __aicore__ inline void ProcessGroup_DoubleBuffer(uint32_t group) {
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        AscendC::LocalTensor<int32_t> xLocalPing = ubAllocator.Alloc<AscendC::TPosition::VECIN, int32_t>(group * tileLength);
        AscendC::LocalTensor<int32_t> xLocalPong = ubAllocator.Alloc<AscendC::TPosition::VECIN, int32_t>(group * tileLength);
        AscendC::LocalTensor<float> sLocal = ubAllocator.Alloc<AscendC::TPosition::VECIN, float>(tileLength);
        AscendC::LocalTensor<float> yLocalPing = ubAllocator.Alloc<AscendC::TPosition::VECOUT, float>(group * tileLength);
        AscendC::LocalTensor<float> yLocalPong = ubAllocator.Alloc<AscendC::TPosition::VECOUT, float>(group * tileLength);
        //
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0); // s可写
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1); // xPing可写
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID3); // xPong可写
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID2); // yPing可写
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID4); // yPong可写
        //
        uint32_t loopCount = (N + tileLength - 1) / tileLength;
        // 先对s循环，再对x循环
        for (uint32_t j = 0; j < loopCount; j++) {
            // 计算tile参数
            uint32_t actualTileLength = N - j * tileLength;
            actualTileLength = (actualTileLength > tileLength) ? tileLength : actualTileLength;
            // pitch是actualTileLength按照32B对齐后的元素数, 因为使用了DataCopyPad, 所以一定要知道才行
            uint32_t pitch = static_cast<uint32_t>((static_cast<uint64_t>(actualTileLength) * sizeof(int32_t) + 31) / 32 * 32 / sizeof(int32_t));
            // s拷贝参数
            AscendC::DataCopyExtParams sCopyParams{};
            sCopyParams.blockCount = 1;
            sCopyParams.blockLen = actualTileLength * sizeof(float);
            sCopyParams.srcStride = 0;
            sCopyParams.dstStride = 0;
            // s填充参数
            AscendC::DataCopyPadExtParams<float> sPadParams{};
            sPadParams.isPad = false;
            sPadParams.leftPadding = 0;
            sPadParams.rightPadding = 0;
            sPadParams.paddingValue = 0.0f;
            // 计算sOffset
            uint32_t sOffset = j * tileLength;
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
            AscendC::DataCopyPad(sLocal, sGm[sOffset], sCopyParams, sPadParams);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
            // x循环
            for (uint32_t row0 = 0; row0 < singleCoreM; row0 += group) {
                uint32_t actualRow = singleCoreM - row0;
                actualRow = (actualRow > group) ? group : actualRow;
                uint32_t loopIdx = (row0 / group) % 2;
                // CopyIn阶段
                AscendC::LocalTensor<int32_t> xLocalBuffer = (loopIdx == 0) ? xLocalPing : xLocalPong;
                AscendC::LocalTensor<float> yLocalBuffer = (loopIdx == 0) ? yLocalPing : yLocalPong;
                uint32_t xEventID = (loopIdx == 0) ? EVENT_ID1 : EVENT_ID3;
                uint32_t yEventID = (loopIdx == 0) ? EVENT_ID2 : EVENT_ID4;
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(xEventID);
                // x拷贝参数
                AscendC::DataCopyExtParams xCopyParams{};
                xCopyParams.blockCount = static_cast<uint16_t>(actualRow);
                xCopyParams.blockLen = actualTileLength * sizeof(int32_t);
                // 1B
                xCopyParams.srcStride = (N - actualTileLength) * sizeof(int32_t);
                // 32B
                xCopyParams.dstStride = 0;
                // x填充参数
                AscendC::DataCopyPadExtParams<int32_t> xPadParams{};
                xPadParams.isPad = false;
                xPadParams.leftPadding = 0;
                xPadParams.rightPadding = 0;
                xPadParams.paddingValue = 0;
                //
                uint32_t xOffset = row0 * N + sOffset;
                AscendC::DataCopyPad(xLocalBuffer, xGm[xOffset], xCopyParams, xPadParams);
                AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(xEventID);
                // Compute阶段
                if (row0 == 0) {
                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                }
                AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(xEventID);
                AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(yEventID);
                for (uint32_t row = 0; row < actualRow; row++) {
                    // DataCopyPad的时候把尾部行元素搬运的时候补齐到了32B，所以Offset要按照补齐后的分形去算
                    uint32_t Offset = row * pitch;
                    AscendC::Cast(yLocalBuffer[Offset], xLocalBuffer[Offset], AscendC::RoundMode::CAST_RINT, actualTileLength);
                    AscendC::Mul(yLocalBuffer[Offset], yLocalBuffer[Offset], sLocal, actualTileLength);
                }
                AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(xEventID);
                AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(yEventID);
                if (row0 + actualRow == singleCoreM) {
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
                }
                //
                AscendC::DataCopyExtParams yCopyParams{};
                yCopyParams.blockCount = static_cast<uint16_t>(actualRow);
                yCopyParams.blockLen = actualTileLength * sizeof(float);
                yCopyParams.srcStride = (pitch - actualTileLength) * sizeof(float) / 32;
                yCopyParams.dstStride = (N - actualTileLength) * sizeof(float);
                // Copyout阶段
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(yEventID);
                AscendC::DataCopyPad(yGm[xOffset], yLocalBuffer, yCopyParams);
                AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(yEventID);
            }
        }
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID3);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID2);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID4);
    }

private:
    AscendC::GlobalTensor<int32_t> xGm;
    AscendC::GlobalTensor<float> sGm, yGm;
    uint32_t M, N, singleCoreM, tileLength;
};

__vector__ __global__ void dequant_custom(GM_ADDR x, GM_ADDR s, GM_ADDR y, 
    uint32_t M, uint32_t N, uint32_t tileLength, bool l2DisableX
) {
    AscendC::InitSocState();
    KernelDequant op;
    op.Init(x, s, y, M, N, tileLength, l2DisableX);
    op.Process2();
    AscendC::PipeBarrier<PIPE_ALL>();
}

__vector__ __global__ void dequant_custom_double_buffer(GM_ADDR x, GM_ADDR s, GM_ADDR y, 
    uint32_t M, uint32_t N, uint32_t tileLength, bool l2DisableX
) {
    AscendC::InitSocState();
    KernelDequant op;
    op.Init(x, s, y, M, N, tileLength, l2DisableX);
    op.ProcessDoubleBuffer();
    AscendC::PipeBarrier<PIPE_ALL>();
}

__vector__ __global__ void dequant_custom_group(GM_ADDR x, GM_ADDR s, GM_ADDR y, 
    uint32_t M, uint32_t N, uint32_t tileLength, uint32_t group, bool l2DisableX
) {
    AscendC::InitSocState();
    KernelDequant op;
    op.Init(x, s, y, M, N, tileLength, l2DisableX);
    op.ProcessGroup(group);
    AscendC::PipeBarrier<PIPE_ALL>();
}

__vector__ __global__ void dequant_custom_group_double_buffer(GM_ADDR x, GM_ADDR s, GM_ADDR y, 
    uint32_t M, uint32_t N, uint32_t tileLength, uint32_t group, bool l2DisableX
) {
    AscendC::InitSocState();
    KernelDequant op;
    op.Init(x, s, y, M, N, tileLength, l2DisableX);
    op.ProcessGroup_DoubleBuffer(group);
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ============================================================================
// CheckUbBudget —— UB 预算校验（4 种模式的差异都收敛在这里）
//
// 两条校验（顺序不能换）：① tileLength 是 8 的倍数（32B 对齐）
//                          ② units × tileLength × 4B ≤ UB（运行时 GetCoreMemSize 查）
//
// units = 2 * xyCopies * rowsPerBuf + 1 + xcastUnits
//           ↑ x 和 y 各一组              │   └ baseline 独占的 xcastLocal
//                                        └ sLocal 常驻（只 1 份，不随 group 放大）
//   baseline=4 | double_buffer=5 | group=2g+1 | group+double_buffer=4g+1
//
// ★ 完整推导、4 种模式的 Alloc 对照表、以及"两处最容易算错的地方"见
//   README「⑤ tile 参数对齐 与 UB 校验函数设计」—— 改这里时请同步核对那两张表。
//
// 返回值：0 = 通过；-1 = 失败（错误信息已打印，调用方直接 return -1 即可）
// ============================================================================
static int32_t CheckUbBudget(platform_ascendc::PlatformAscendC* platform,
                             uint32_t tileLength, uint32_t group, bool doubleBuffer,
                             uint32_t M, uint32_t N, uint32_t coreNum)
{
    constexpr uint32_t ELEM_BYTES = 4;

    // ---------------- ① 32B 对齐校验 ----------------
    if (tileLength == 0u || (tileLength * ELEM_BYTES) % 32u != 0u) {
        printf("[ERROR] tileLength=%u 非法：tileLength*%u 必须是 32 的倍数",
               tileLength, ELEM_BYTES);
        return -1;
    }
    
    // ---------------- ② 算出本模式的 UB 单元数（精确值，不是保守估计）----------------
    const uint32_t xyCopies   = doubleBuffer ? 2u : 1u;      // x / y 各复制几份
    const uint32_t rowsPerBuf = (group > 0u) ? group : 1u;   // 每个 x/y buffer 装几行
    const bool     isBaseline = (group == 0u && !doubleBuffer);
    const uint64_t sUnits     = 1ull;                        // sLocal 常驻 1 份
    const uint64_t xcastUnits = isBaseline ? 1ull : 0ull;    // 只有 Process1/Process2 有 xcastLocal
    const uint64_t units      = 2ull * xyCopies * rowsPerBuf + sUnits + xcastUnits;

    // 运行期取真实 UB 容量（用户可用容量，已扣掉系统预留）
    uint64_t ubBytes = 0;
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubBytes);

    const uint64_t needBytes = units * tileLength * ELEM_BYTES;
    const uint64_t unitBytes = units * ELEM_BYTES;            // 每 1 个 tileLength 要多少字节

    // ---------------- ③ 打印本模式的实际预算（便于对照与回归）----------------
    const char* modeName = doubleBuffer ? ((group > 0u) ? "group+double_buffer" : "double_buffer")
                                        : ((group > 0u) ? "group"               : "baseline");
    printf("[INFO] M=%u N=%u tileLength=%u group=%u coreNum=%u  模式=%s\n",
           M, N, tileLength, group, coreNum, modeName);
    printf("[INFO] UB 预算 = %llu 个单元 (x/y 各 %u 份 × %u 行 + s 1 份%s) × %u 元素 × %u B"
           " = %llu B / UB %llu B (%.1f%%)\n",
           static_cast<unsigned long long>(units), xyCopies, rowsPerBuf,
           isBaseline ? " + xcast 1 份" : "",
           tileLength, ELEM_BYTES,
           static_cast<unsigned long long>(needBytes),
           static_cast<unsigned long long>(ubBytes),
           100.0 * static_cast<double>(needBytes) / static_cast<double>(ubBytes));

    // ---------------- ④ 容量校验 + 给出可调整的上限 ----------------
    if (needBytes > ubBytes) {
        printf("[ERROR] UB 不够（模式 %s）：需要 %llu B，UB 只有 %llu B\n",
               modeName,
               static_cast<unsigned long long>(needBytes),
               static_cast<unsigned long long>(ubBytes));
        // 反推上限：给两个可调项各自的上界，方便直接改命令行参数
        printf("        按当前参数，上限约： tileLength <= %llu\n",
               static_cast<unsigned long long>(ubBytes / unitBytes));
        if (group > 0u) {
            // needBytes = rowsPerBuf * (2*xyCopies*tileLength*4) + sUnits*tileLength*4 (+xcast)
            const uint64_t perRowBytes = 2ull * xyCopies * tileLength * ELEM_BYTES;   // 每多 1 行
            const uint64_t fixedBytes  = (sUnits + xcastUnits) * tileLength * ELEM_BYTES; // 不随行变的部分
            if (perRowBytes > 0u && ubBytes > fixedBytes) {
                printf("                             group      <= %llu\n",
                       static_cast<unsigned long long>((ubBytes - fixedBytes) / perRowBytes));
            }
        }
        return -1;
    }
    return 0;
}

int32_t main(int32_t argc, char* argv[]) {
    // 形状
    uint32_t M = 1024, N = 1024;
    // tile参数
    uint32_t tileLength = 1024;

    // 是否关闭 xGm 的l2 cache
    bool l2_cache = false;
    // 是否开启双缓冲 
    bool double_buffer = false;
    // group表示一次搬运处理的行数，默认0 = 不用GROUP版
    uint32_t group = 0;

    if (argc > 1) M = atoi(argv[1]);
    if (argc > 2) N = atoi(argv[2]);
    if (argc > 3) tileLength = atoi(argv[3]);
    if (argc > 4) l2_cache = (atoi(argv[4]) != 0);   // 【更新】非0 ⇒ 关闭 xGm 的 L2 Cache
    if (argc > 5) double_buffer = (atoi(argv[5]) != 0);
    if (argc > 6) group = atoi(argv[6]);

    // 解析完参数后收窄 tileLength：不超过 8192，且向上取整到 8 的倍数。
    // 向上取整到 8 的倍数是为了满足 32B 对齐（校验见 CheckUbBudget）。
    tileLength = (std::min(tileLength, 8192u) + 7u) / 8u * 8u;

    const uint32_t totalLength = M * N;
    const uint32_t xByteSize = totalLength * sizeof(int32_t);
    const uint32_t sByteSize = N * sizeof(float);
    const uint32_t yByteSize = totalLength * sizeof(float);

    auto platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint32_t coreNum = platform->GetCoreNumAiv();
    coreNum = std::min(coreNum, M);

    // 现在全部收敛到 CheckUbBudget()，它按「模式」自动推出 buffer 单元数：
    //     units单元计算如下：
    //     baseline             : 2*1*1 + 1 + 1 = 4   ← +1 是 baseline 独占的 xcastLocal
    //     double_buffer        : 2*2*1 + 1     = 5
    //     group                : 2*1*group + 1
    //     group+double_buffer  : 2*2*group + 1
    // 校验内容：① tileLength 是 8 的倍数（32B 对齐）
    //          ② units × tileLength × 4B ≤ 运行时查到的 UB 容量
    // 失败时会打印「当前模式下的可调上限」，照改命令行参数即可。
    if (CheckUbBudget(platform, tileLength, group, double_buffer, M, N, coreNum) != 0) {
        return -1;
    }

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* xHost = nullptr;
    uint8_t* sHost = nullptr;
    uint8_t* yHost = nullptr;
    uint8_t* xDevice = nullptr;
    uint8_t* sDevice = nullptr;
    uint8_t* yDevice = nullptr;
    aclrtMallocHost(reinterpret_cast<void**>(&xHost), xByteSize);
    aclrtMallocHost(reinterpret_cast<void**>(&sHost), sByteSize);
    aclrtMallocHost(reinterpret_cast<void**>(&yHost), yByteSize);
    aclrtMalloc(reinterpret_cast<void**>(&xDevice), xByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&sDevice), sByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&yDevice), yByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    size_t readSize = 0;
    if (!ReadFile("./input/input_x.bin", readSize, xHost, xByteSize) || readSize != xByteSize) {
        printf("[ERROR] 读取 ./input/input_x.bin 失败或大小不符：期望 %u 字节，实际 %zu 字节\n",
               xByteSize, readSize);
        return -1;
    }
    readSize = 0;

    if (!ReadFile("./input/input_scale.bin", readSize, sHost, sByteSize) || readSize != sByteSize) {
        printf("[ERROR] 读取 ./input/input_scale.bin 失败或大小不符：期望 %u 字节，实际 %zu 字节\n",
               sByteSize, readSize);
        return -1;
    }

    aclrtMemcpy(xDevice, xByteSize, xHost, xByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(sDevice, sByteSize, sHost, sByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    const char* l2Tag = l2_cache ? "x 不走 L2" : "x 走 L2";
    if (group > 0 && double_buffer) {
        printf("[MODE] group+double_buffer (group=%u 行/批, 2 份 buffer)  |  %s\n", group, l2Tag);
        dequant_custom_group_double_buffer<<<coreNum, 0, stream>>>(xDevice, sDevice, yDevice, M, N, tileLength, group, l2_cache);
    } else if (group > 0) {
        printf("[MODE] group (group=%u 行/批, single buffer)  |  %s\n", group, l2Tag);
        dequant_custom_group<<<coreNum, 0, stream>>>(xDevice, sDevice, yDevice, M, N, tileLength, group, l2_cache);
    } else if (double_buffer) {
        printf("[MODE] double_buffer (2 份 buffer, single row)  |  %s\n", l2Tag);
        dequant_custom_double_buffer<<<coreNum, 0, stream>>>(xDevice, sDevice, yDevice, M, N, tileLength, l2_cache);
    } else {
        printf("[MODE] baseline (single buffer, single row)  |  %s\n", l2Tag);
        dequant_custom<<<coreNum, 0, stream>>>(xDevice, sDevice, yDevice, M, N, tileLength, l2_cache);
    }

    aclrtSynchronizeStream(stream);
    aclrtMemcpy(yHost, yByteSize, yDevice, yByteSize, ACL_MEMCPY_DEVICE_TO_HOST);

    if (!WriteFile("./output/output.bin", yHost, yByteSize)) {
        printf("[ERROR] 写出 ./output/output.bin 失败\n");
        return -1;
    }
    
    aclrtFree(xDevice);
    aclrtFree(sDevice);
    aclrtFree(yDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(sHost);
    aclrtFreeHost(yHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    printf("done: 结果已写入 ./output/output.bin\n");

    return 0;
}